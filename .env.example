# Copy this file to ".env" and fill in the values. NEVER commit ".env".
# [SECURITY #1/#9] Secrets live in environment variables, not in source code.

# Required. At least 32 characters in production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

PORT=3000
DB_FILE=./data/tickets.db
JWT_EXPIRES_IN=1h
MAX_SEATS_PER_USER=4

# Optional: Redis for a cache shared by all cluster workers.
# Leave empty to use the in-memory cache.
# REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=15

# Optional: number of cluster workers (default = number of CPU cores)
# WORKERS=4

# Set to 1 when running behind a reverse proxy / load balancer
# TRUST_PROXY=1

# Used by "npm run seed" to create the first admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword1
